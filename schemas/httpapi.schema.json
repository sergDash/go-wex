{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://go-wex.local/httpapi-4.schema.json",
  "title": "Настройки HTTP-службы",
  "type": "object",
  "additionalProperties": false,
  "required": ["server", "interface", "store"],
  "properties": {
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["addr"],
      "properties": {
        "addr": {
          "type": "string",
          "minLength": 1,
          "description": "адрес HTTP-службы, например 127.0.0.1:4480"
        }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dir"],
      "properties": {
        "dir": {
          "type": "string",
          "minLength": 1,
          "description": "каталог статики относительно каталога запуска"
        }
      }
    },
    "store": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "файл хранилища относительно каталога запуска"
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rules": {
          "type": "array",
          "description": "пороги простоя: после какого простоя разрешён класс работы",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["after", "class"],
            "properties": {
              "after": {
                "type": "string",
                "minLength": 1,
                "description": "длительность в синтаксисе Go, например 10s или 5m"
              },
              "class": {
                "type": "string",
                "enum": ["interactive", "background"],
                "description": "класс работы, который разрешён после порога"
              }
            }
          }
        }
      }
    },
    "journal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "maxSize", "keep"],
      "description": "журнал работы; без раздела журнал отключён",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "файл журнала относительно каталога запуска"
        },
        "maxSize": {
          "type": "integer",
          "minimum": 1,
          "description": "предел файла в байтах до ротации"
        },
        "keep": {
          "type": "integer",
          "minimum": 1,
          "description": "число старых копий журнала"
        }
      }
    }
  }
}
