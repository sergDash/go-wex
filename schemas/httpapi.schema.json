{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://go-wex.local/httpapi-11.schema.json",
  "title": "Настройки HTTP-службы",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "server",
    "interface",
    "store"
  ],
  "properties": {
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "addr"
      ],
      "properties": {
        "addr": {
          "type": "string",
          "minLength": 1,
          "description": "адрес HTTP-службы, например 127.0.0.1:4480"
        },
        "open": {
          "type": "boolean",
          "default": false,
          "description": "открыть страницу в браузере после запуска; в образце включено"
        },
        "readHeaderTimeout": {
          "type": "string",
          "minLength": 1,
          "description": "предел чтения заголовков запроса, например 5s; пусто — по умолчанию"
        },
        "idleTimeout": {
          "type": "string",
          "minLength": 1,
          "description": "предел простоя соединения, например 60s; пусто — по умолчанию"
        },
        "maxBody": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "предел тела запроса в байтах; ноль — без предела"
        }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dir"
      ],
      "properties": {
        "dir": {
          "type": "string",
          "minLength": 1,
          "description": "каталог статики относительно каталога запуска"
        }
      }
    },
    "lang": {
      "type": "object",
      "additionalProperties": false,
      "description": "словари переводов: пустой раздел означает умолчания",
      "properties": {
        "dir": {
          "type": "string",
          "minLength": 1,
          "description": "каталог словарей относительно каталога запуска, по умолчанию lang"
        },
        "base": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
          "description": "базовая локаль для запасного пути, по умолчанию ru-RU"
        }
      }
    },
    "store": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "файл хранилища относительно каталога запуска"
        }
      }
    },
    "jobs": {
      "type": "object",
      "additionalProperties": false,
      "description": "правило хранения очереди работ",
      "properties": {
        "keep": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "сколько завершённых строк очереди держать; ноль оставляет все"
        }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "description": "правила для внутренних служб",
      "properties": {
        "restart": {
          "type": "object",
          "additionalProperties": false,
          "description": "перезапуск отказавшей службы",
          "properties": {
            "after": {
              "type": "string",
              "minLength": 1,
              "description": "сколько ждать перед повтором, например 1s"
            },
            "max": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "description": "сколько раз пробовать; ноль означает, что перезапуска нет"
            }
          }
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rules": {
          "type": "array",
          "description": "пороги простоя: после какого простоя разрешён класс работы",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "after",
              "class"
            ],
            "properties": {
              "after": {
                "type": "string",
                "minLength": 1,
                "description": "длительность в синтаксисе Go, например 10s или 5m"
              },
              "class": {
                "type": "string",
                "enum": [
                  "interactive",
                  "background"
                ],
                "description": "класс работы, который разрешён после порога"
              }
            }
          }
        }
      }
    },
    "modules": {
      "type": "object",
      "additionalProperties": false,
      "description": "какие модули включать; выключенный модуль не объявляет ничего",
      "properties": {
        "disabled": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "имена выключенных модулей; неизвестное имя — ошибка"
        },
        "settings": {
          "type": "object",
          "description": "разделы настроек по имени модуля; форму раздела знает модуль",
          "additionalProperties": {
            "type": "object"
          }
        }
      }
    },
    "journal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "maxSize",
        "keep"
      ],
      "description": "журнал работы; без раздела журнал отключён",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "файл журнала относительно каталога запуска"
        },
        "maxSize": {
          "type": "integer",
          "minimum": 1,
          "description": "предел файла в байтах до ротации"
        },
        "keep": {
          "type": "integer",
          "minimum": 1,
          "description": "число старых копий журнала"
        }
      }
    }
  }
}
