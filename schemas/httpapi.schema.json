{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://go-wex.local/httpapi-2.schema.json",
  "title": "Настройки HTTP-службы",
  "type": "object",
  "additionalProperties": false,
  "required": ["server", "interface", "store"],
  "properties": {
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["addr"],
      "properties": {
        "addr": {
          "type": "string",
          "minLength": 1,
          "description": "адрес HTTP-службы, например 127.0.0.1:8080"
        }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dir"],
      "properties": {
        "dir": {
          "type": "string",
          "minLength": 1,
          "description": "каталог статики относительно каталога запуска"
        }
      }
    },
    "store": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "файл хранилища относительно каталога запуска"
        }
      }
    }
  }
}
