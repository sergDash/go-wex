{
  "server": {
    "addr": "127.0.0.1:4480"
  },
  "interface": {
    "dir": "interface"
  },
  "store": {
    "path": "data/store.json"
  },
  "schedule": {
    "rules": [
      {"after": "0s", "class": "interactive"},
      {"after": "10s", "class": "background"}
    ]
  },
  "journal": {
    "path": "data/journal.log",
    "maxSize": 1048576,
    "keep": 5
  }
}
