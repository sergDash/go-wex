{
  "server": {
    "addr": "127.0.0.1:4480",
    "open": true,
    "readHeaderTimeout": "5s",
    "idleTimeout": "60s",
    "maxBody": 1048576
  },
  "interface": {
    "dir": "interface"
  },
  "lang": {
    "dir": "lang",
    "base": "ru-RU"
  },
  "store": {
    "path": "data/store.json"
  },
  "jobs": {
    "keep": 500
  },
  "services": {
    "restart": {
      "after": "1s",
      "max": 3
    }
  },
  "schedule": {
    "rules": []
  },
  "modules": {
    "disabled": [],
    "settings": {
      "demo": {
        "tickPeriod": "10s",
        "minIdle": "3s"
      }
    }
  },
  "journal": {
    "path": "data/journal.log",
    "maxSize": 1048576,
    "keep": 5
  }
}
